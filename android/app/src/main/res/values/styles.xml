<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.H4xtorShare" parent="android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:colorAccent">@color/h4_accent</item>
        <item name="android:colorPrimary">@color/h4_accent</item>
        <item name="android:windowBackground">@color/h4_background</item>
        <item name="android:statusBarColor">@color/h4_background</item>
        <item name="android:navigationBarColor">@color/h4_background</item>
    </style>

    <style name="Theme.H4xtorShare.Sheet">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.H4xtorShare.Invisible">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
</resources>
