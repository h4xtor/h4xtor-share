<?xml version="1.0" encoding="utf-8"?>
<!-- The smile deepens and fills in (an open mouth), stays open a moment, then closes. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="sequentially">
    <set>
        <objectAnimator android:propertyName="pathData" android:valueFrom="M41,67Q50,75 59,67"
            android:valueTo="M40,65Q50,86 60,65" android:valueType="pathType" android:duration="200"
            android:interpolator="@android:interpolator/decelerate_quad" />
        <objectAnimator android:propertyName="fillColor" android:valueFrom="#003B2A20"
            android:valueTo="#FF3B2A20" android:valueType="colorType" android:duration="200" />
    </set>
    <set>
        <objectAnimator android:propertyName="pathData" android:valueFrom="M40,65Q50,86 60,65"
            android:valueTo="M41,67Q50,75 59,67" android:valueType="pathType" android:startOffset="550"
            android:duration="240" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <objectAnimator android:propertyName="fillColor" android:valueFrom="#FF3B2A20"
            android:valueTo="#003B2A20" android:valueType="colorType" android:startOffset="550"
            android:duration="240" />
    </set>
</set>
